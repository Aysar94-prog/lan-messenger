    {
      "id": "scheduler-rule-1-user-initiated",
      "category": "scheduler",
      "description": "Rule 1: user-initiated attachment always admitted immediately regardless of pending voice/image admissions",
      "source": null,
      "expectations": {
        "rule": 1,
        "input": {
          "user_initiated": true,
          "voice_pending": true,
          "image_pending": true,
          "consecutive_voice_admissions": 2
        },
        "expected": {
          "admitted": true,
          "priority": "user-initiated",
          "interrupted": false,
          "voice_counter_reset": false
        }
      }
    },
    {
      "id": "scheduler-rule-2-voice-next",
      "category": "scheduler",
      "description": "Rule 2: voice message retrieval is next priority after user-initiated when no user-initiated is pending",
      "source": null,
      "expectations": {
        "rule": 2,
        "input": {
          "user_initiated": false,
          "voice_pending": true,
          "image_pending": true,
          "consecutive_voice_admissions": 1
        },
        "expected": {
          "admitted": true,
          "priority": "voice",
          "interrupted": false
        }
      }
    },
    {
      "id": "scheduler-rule-3-image-last",
      "category": "scheduler",
      "description": "Rule 3: image retrieval is last priority, admitted only when no user-initiated or voice is pending",
      "source": null,
      "expectations": {
        "rule": 3,
        "input": {
          "user_initiated": false,
          "voice_pending": false,
          "image_pending": true,
          "consecutive_voice_admissions": 0
        },
        "expected": {
          "admitted": true,
          "priority": "image",
          "interrupted": false
        }
      }
    },
    {
      "id": "scheduler-rule-4-fairness",
      "category": "scheduler",
      "description": "Rule 4: three consecutive automatic voice admissions force an image admission (3:1 fairness); counter resets after forced image",
      "source": null,
      "expectations": {
        "rule": 4,
        "input": {
          "user_initiated": false,
          "voice_pending": true,
          "image_pending": true,
          "consecutive_voice_admissions": 3
        },
        "expected": {
          "admitted": true,
          "priority": "image",
          "interrupted": false,
          "voice_counter_reset": true
        }
      }
    },
    {
      "id": "scheduler-rule-5-no-interruption",
      "category": "scheduler",
      "description": "Rule 5: voice and image admissions are never paused or cancelled once started",
      "source": null,
      "expectations": {
        "rule": 5,
        "input": {
          "admission_in_progress": true,
          "admission_type": "voice",
          "higher_priority_arrives": true
        },
        "expected": {
          "interrupted": false,
          "cancelled": false,
          "completes_normally": true
        }
      }
    },
    {
      "id": "scheduler-rule-6-next-eligible",
      "category": "scheduler",
      "description": "Rule 6: manual request arriving while both capacity slots are occupied is queued, then admitted with user-initiated priority as the next eligible admission once a slot is released, ahead of pending voice and image",
      "source": null,
      "expectations": {
        "rule": 6,
        "input": {
          "manual_request_queued": true,
          "capacity_available": true,
          "voice_pending": true,
          "image_pending": true,
          "consecutive_voice_admissions": 2
        },
        "expected": {
          "admitted": true,
          "priority": "user-initiated",
          "interrupted": false,
          "selection_reason": "manual-next-eligible-after-slot-released"
        }
      }
    },
    {
      "id": "scheduler-rule-7-counter-success-only",
      "category": "scheduler",
      "description": "Rule 7: consecutive-voice counter increments only on successful admission, not on attempt or failure",
      "source": null,
      "expectations": {
        "rule": 7,
        "input": {
          "admission_attempted": true,
          "admission_successful": false,
          "consecutive_voice_admissions_before": 2
        },
        "expected": {
          "counter_unchanged": true,
          "consecutive_voice_admissions_after": 2
        }
      }
    },
    {
      "id": "scheduler-rule-8-offline-preserve",
      "category": "scheduler",
      "description": "Rule 8: offline transition preserves admission state; pending admissions and counters survive connectivity loss",
      "source": null,
      "expectations": {
        "rule": 8,
        "input": {
          "offline_transition": true,
          "pending_voice": true,
          "pending_image": false,
          "consecutive_voice_admissions": 1
        },
        "expected": {
          "state_preserved": true,
          "pending_voice_after": true,
          "consecutive_voice_admissions_after": 1
        }
      }
    },
    {
      "id": "scheduler-rule-9-restart-reconstruct",
      "category": "scheduler",
      "description": "Rule 9: restart reconstructs admission offers and partial-transfer state from durable history; the fairness counter resets to 0 and pending queues are restored",
      "source": null,
      "expectations": {
        "rule": 9,
        "input": {
          "restart": true,
          "durable_history_available": true,
          "durable_consecutive_voice": 2,
          "durable_pending_voice": true
        },
        "expected": {
          "reconstructed": true,
          "consecutive_voice_admissions_after": 0,
          "pending_voice_after": true,
          "history_matches_durable": true
        }
      }
    }
  ]
