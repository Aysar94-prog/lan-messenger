<?xml version="1.0" encoding="utf-8"?>
<!-- Release-only runtime packs; ordinary builds retain the root offline NuGet.Config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="vendored" value="../vendor/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="../../outputs/.build/nuget" />
  </config>
</configuration>
